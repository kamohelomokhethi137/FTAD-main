classDiagram
class DatabaseManager {
    +connect() bool
    +disconnect()
    +isConnected() bool
    +lastError() String
    +initializeSchema() bool
}

class TransactionRepository {
    +addTransaction(Transaction) bool
    +getAllTransactions() List~Transaction~
    +generateNextTransactionId() String
