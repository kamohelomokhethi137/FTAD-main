\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Figure G.6 --- Entity relationships. Foreign keys run transactions → anomalies → investigations → investigation\_events, with cascade deletes in the same direction.}}{76}{figure.0.6}\protected@file@percent }
