\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Figure G.1 --- Layering and call relationships. The Qt client sits above the \texttt  {ftad\_core} static library, which is the only component that touches SQLite. \texttt  {ReportsPage} and \texttt  {SettingsPage} (asterisked) are placeholders.}}{72}{figure.0.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Figure G.2 --- Backend classes. Services on the left collaborate through the value types on the right; \texttt  {Detection\-Settings} (shaded) is the shared configuration object that every rule reads.}}{73}{figure.0.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Figure G.3 --- Actors and use cases. A single analyst role drives import, analysis, case review and reporting, all against the local database.}}{74}{figure.0.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Figure G.4 --- Detection activity. Every transaction passes all four rule checks before scoring, so a single transaction can accumulate several hits.}}{75}{figure.0.4}\protected@file@percent }
